msgstr "Liên tục giám sát kết nối cơ sở dữ liệu, cấu hình PHP, dung lượng đĩa, trạng thái bộ nhớ đệm và tệp GeoLite2 với dấu thời gian chính xác."

#: client/pages/dashboard/about/AboutPage.tsx:319
msgid "Localization"
msgstr "Bản địa hóa ngôn ngữ"

