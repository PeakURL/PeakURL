{
	"name": "peakurl",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"i18n:pot": "php scripts/i18n/build-pot.php",
		"i18n:update-po": "php scripts/i18n/update-po.php",
		"i18n:compile": "php scripts/i18n/compile-catalogs.php",
		"i18n:build": "npm run i18n:pot && npm run i18n:compile",
		"release:build": "sh scripts/build-release.sh",
		"release:upload": "sh scripts/upload-release.sh",
		"smoke:auth": "sh scripts/smoke-auth.local.sh",
		"lint": "npm run lint:web && npm run lint:php",
		"lint:web": "eslint ui",
		"lint:php": "composer --working-dir=app run phpcs",
		"lint:php:syntax": "find app site -path 'app/vendor' -prune -o -path 'site/config-sample.php' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
		"format": "npm run format:web && npm run format:php",
		"format:check": "npm run format:web:check && npm run format:php:check",
		"format:web": "prettier . --write --ignore-unknown",
		"format:web:check": "prettier . --check --ignore-unknown",
		"format:php": "composer --working-dir=app run phpcbf",
		"format:php:check": "composer --working-dir=app run phpcs",
		"preview": "vite preview",
		"docker:up": "docker compose up --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@reduxjs/toolkit": "^2.12.0",
		"@tailwindcss/vite": "^4.3.3",
		"@visx/geo": "^4.0.0",
		"@visx/zoom": "^4.0.0",
		"@wordpress/i18n": "^6.25.0",
		"chart.js": "^4.5.1",
		"d3-scale": "^4.0.2",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.28.0",
		"qrcode": "^1.5.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-redux": "^9.3.0",
		"react-router": "^8.3.0",
		"tailwindcss": "^4.3.3",
		"topojson-client": "^3.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.2",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/topojson-client": "^3.1.5",
		"@vitejs/plugin-react": "^6.0.5",
		"eslint": "^10.8.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0"
	}
}
