{
	"name": "peakurl",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"i18n:pot": "php scripts/i18n/build-pot.php",
		"i18n:update-po": "php scripts/i18n/update-po.php",
		"i18n:compile": "php scripts/i18n/compile-catalogs.php",
		"i18n:build": "npm run i18n:pot && npm run i18n:compile",
		"release:build": "sh scripts/build-release.sh",
		"release:upload": "sh scripts/upload-release.sh",
		"smoke:auth": "sh scripts/smoke-auth.sh",
		"test:server": "composer --working-dir=server test",
		"test:unit": "playwright test --project=unit",
		"test:e2e": "playwright test",
		"test": "npm run test:server && npm run test:unit",
		"lint": "npm run lint:web && npm run lint:php",
		"lint:web": "eslint client --cache",
		"lint:web:fix": "eslint client --cache --fix",
		"lint:php": "composer --working-dir=server run phpcs",
		"lint:php:syntax": "find server -path 'server/vendor' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l && php -l index.php install.php setup-config.php database-error.php",
		"format": "npm run format:web && npm run format:php",
		"format:check": "npm run format:web:check && npm run format:php:check",
		"format:web": "prettier . --write --ignore-unknown",
		"format:web:check": "prettier . --check --ignore-unknown",
		"format:php": "composer --working-dir=server run phpcbf",
		"format:php:check": "composer --working-dir=server run phpcs",
		"preview": "vite preview",
		"prepare": "husky",
		"docker:up": "docker compose up --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f"
	},
	"lint-staged": {
		"client/**/*.{ts,tsx}": [
			"eslint --cache --fix",
			"prettier --write"
		],
		"client/**/*.css": [
			"prettier --write"
		],
		"**/*.{json,md,yml,yaml}": [
			"prettier --write"
		],
		"server/**/*.php": [
			"composer --working-dir=server run phpcbf --"
		]
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@reduxjs/toolkit": "^2.12.0",
		"@tailwindcss/vite": "^4.3.3",
		"@visx/geo": "^4.0.0",
		"@visx/zoom": "^4.0.0",
		"@wordpress/i18n": "^6.28.0",
		"chart.js": "^4.5.1",
		"d3-scale": "^4.0.2",
		"date-fns": "^4.4.0",
		"iso-3166": "4.4.0",
		"lucide-react": "^1.45.0",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-redux": "^9.3.0",
		"react-router": "^8.3.1",
		"tailwindcss": "^4.3.3",
		"topojson-client": "^3.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.2.0",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/topojson-client": "^3.1.5",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^9.21.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	}
}
